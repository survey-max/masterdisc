{
  "name": "coachersai-portal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file=.env.local --import tsx scripts/seed-portal.ts",
    "dry-run": "node --import tsx scripts/legacy-dry-run.ts",
    "dry-run:db": "node --env-file=.env.local --import tsx scripts/legacy-dry-run.ts --check-existing",
    "typecheck:vercel": "tsc --noEmit -p tsconfig.vercel.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "next": "15.5.23",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "tsx": "^4.23.12",
    "typescript": "5.7.2"
  }
}
