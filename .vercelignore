# Ikke en del af det udgivne site.
# GitHub Pages (Jekyll) sprang automatisk dot-mapper over; Vercel gør ikke,
# så .claude/ ville ellers blive serveret offentligt.
.claude
test.txt

# GitHub Pages-specifik custom-domain-fil. Bliver i git, så GitHub Pages
# fortsat virker indtil DNS er flyttet, men skal ikke serveres fra Vercel.
CNAME

# Selvstændig Next.js-app med eget build. Det statiske rod-deploy bygger den
# ikke — uden denne linje uploades dens kildekode blot som filer, så fx
# /app-rewrite/app/page.tsx og /app-rewrite/data/example/*.json kan hentes
# offentligt. App'en skal deployes som sit eget Vercel-projekt med
# Root Directory = app-rewrite.
app-rewrite/*
!app-rewrite/package.json
!app-rewrite/pnpm-lock.yaml
!app-rewrite/next.config.ts
!app-rewrite/tsconfig.json
!app-rewrite/app
!app-rewrite/lib
!app-rewrite/public
!app-rewrite/scripts
!app-rewrite/docs
!app-rewrite/supabase-migrations-til-hovedrepo
