# @supabase/supabase-js' bundlede typer (dist/index.d.mts) importerer
# AuthClient m.fl. fra @supabase/auth-js, @supabase/postgrest-js,
# @supabase/realtime-js, @supabase/storage-js og @supabase/functions-js.
# De er transitive afhaengigheder, og pnpm's strikte layout laegger dem kun i
# node_modules/.pnpm/. Foelger typechecken ikke symlinks til deres realpath
# — hvilket Vercels middleware-typecheck ikke goer — kan importen ikke
# resolves, SupabaseAuthClient arver ingenting, og getUser/signOut/
# signInWithPassword "findes ikke". skipLibCheck skjuler selve
# modul-fejlen, saa kun TS2339 paa brugsstedet slipper ud.
#
# Hoister dem til node_modules/@supabase/, saa de kan resolves fra roden
# uanset symlink-strategi. Versionerne styres fortsat udelukkende af
# supabase-js' egne pins, saa de aldrig kan drive fra hinanden.
public-hoist-pattern[]=@supabase/*
