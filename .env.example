# Kopiér til .env.local og udfyld. .env* er git-ignoreret — nøgler må ALDRIG
# committes. Se docs/SUPABASE.md.

# ---------------------------------------------------------------- Supabase
# Det DELTE projekt (v2), som også rummer CRM og besvarelser. Portalen bruger
# kun schemaet `portal` og bucketen `portal-arkiv`.
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co

# Den hemmelige nøgle. Bruges KUN server-side (API-routes, server actions,
# scripts) og går uden om RLS. Må ikke findes i klientkode.
SUPABASE_SECRET_KEY=sb_secret_...

# Publishable-nøglen bruges ikke i denne skive (al adgang er server-side).
# Den står her, fordi skive 2 (Supabase Auth i browseren) får brug for den.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ------------------------------------------------------------ portalens API
# Spærring foran /api/portal/*, indtil rigtig auth findes i skive 2. App'en er
# offentligt tilgængelig uden login, så uden en token ville
# routene udlevere portalen til alle. I produktion svarer de 503, hvis den
# mangler; lokalt er den valgfri.
PORTAL_API_TOKEN=

# Hvordan datalaget når Supabase:
#   direct (standard) — server-side kald i samme proces
#   api               — over app'ens egne /api/portal/*-routes
PORTAL_DATA_MODE=direct

# Kun relevant med PORTAL_DATA_MODE=api: hvor routene ligger.
# Lokalt gættes http://127.0.0.1:3000, hvis den ikke er sat.
PORTAL_API_BASE_URL=

# ------------------------------------------------------------------- diverse
# Hvilken bruger portalen vises som, indtil der findes rigtig auth (lib/auth).
# Uden den vælges den første ikke-spærrede admin. Efter `pnpm seed` er det
# Anna Eksempel.
MOCK_USER_ID=

# DISC-API'et, som konsulentkoder valideres mod.
# NEXT_PUBLIC_DISC_API_BASE=https://www.unicoachers.dk

# Datamappe for POC'ens JSON-filer. Bruges IKKE længere af app'en (datalaget
# ligger i Supabase), men scripts kan pege på en anden mappe:
#   SEED_DATA_DIR      anonyme eksempeldata til `pnpm seed` (default data/example)
#   LEGACY_DATA_DIR    POC-data til `pnpm dry-run` (default legacy-php/data)

# ----------------------------------------------------------- portalens adgang
# Hvem der må logge ind i portalen afgøres IKKE af en variabel:
# brugeren skal i `public.user_profiles` (coachersuniversed's brugertabel i det
# delte Supabase-projekt) have rollen `admin`/`ejer` ELLER en egen rolle med
# Jobmatch slået til (custom_roles.permissions.modules.jobmatch), og må ikke
# være disabled. Opslaget bruger NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SECRET_KEY
# ovenfor — mangler de, AFVISES alle logins (fail closed). Se docs/AUTH.md.

# Hemmeligheden, portalens egen sessionscookie signeres med (HMAC-SHA256).
# Mindst 32 tegn — generér med `openssl rand -base64 48`. Mangler den,
# afvises alle logins (fail closed). At rotere den logger alle ud.
PORTAL_SESSION_SECRET=
